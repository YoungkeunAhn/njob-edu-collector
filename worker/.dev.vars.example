# 로컬 개발(wrangler dev)용 시크릿. 이 파일을 .dev.vars 로 복사해 채운다(.dev.vars 는 커밋하지 않는다).
# 운영에는 같은 이름으로 `npx wrangler secret put <이름>` — docs/07-운영/배포-런북.md 4절

# Supabase: Settings → API
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 텔레그램 알림(없으면 알림만 생략)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 소스 인증키(없으면 그 소스만 실패로 기록)
SEOUL_API_KEY=
DATA_GO_KR_KEY=
YOUTHCENTER_API_KEY=

# 찜·토스 로그인(backlogs/찜-마감알림). mTLS 인증서는 시크릿이 아니라 wrangler.toml 의 mtls_certificates 바인딩
SESSION_SECRET=
# 토스 연결 끊기 콜백이 보내는 Authorization 헤더 값: "Basic <base64(아이디:비밀번호)>". 콘솔 "Basic Auth 헤더" 칸에는 "아이디:비밀번호" 원문
TOSS_UNLINK_AUTH=
# 찜 마감 알림 캠페인 발송 코드(njob-matching-…). 검수 승인 뒤에 넣는다
PUSH_TEMPLATE_CODE=
